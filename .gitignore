node_modules/

# Environment variables
.env
.env.*

# Next.js build artifacts
src/app/.next/
src/app/out/

# TypeScript incremental build cache
*.tsbuildinfo

# Wrangler dev state
workers/.wrangler/

# OS files
.DS_Store
Thumbs.db

# Data files (large, can be regenerated from source).
# The recursive form matters: data/*.json does NOT match data/wbw/1.json, and the
# word-by-word cache is 114 files / ~16 MB.
data/

# Local worker secrets (rotated 2026-07-26; the previous value was committed)
workers/.dev.vars

# Cloudflare/CI secret bundle handed over for the local session — never commit
languagebuilder.env

# Generated design-system bundle for claude.ai/design (regenerate with
# scripts/gen-design-system.mjs; published via DesignSync, not committed).
.design-system/

# Local audit harness: serves the built app with a throwaway localhost token.
.claude/launch.json

# Local wrangler state: miniflare D1 (tens of MB), dev bundles, caches.
# workers/.wrangler was already covered; the repo root one appeared when
# `wrangler pages dev` ran from here for the UI audit.
.wrangler/
