{
  "name": "bayan-workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:pages": "esbuild src/pages-entry.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=../src/app/out/_worker.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:db-types": "node ../scripts/gen-db-types.mjs --check",
    "gen:db-types": "node ../scripts/gen-db-types.mjs"
  },
  "dependencies": {
    "hono": "^4.5.0",
    "jose": "^6.2.4",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
